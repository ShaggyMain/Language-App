      "type": "mcq",
      "prompt": "Ich kaufe ___ Apfel.",
      "options": ["der", "die", "das", "den"],
      "answer": 3
    },
    {
      "type": "mcq",
      "prompt": "Sie sieht ___ Frau.",
      "options": ["der", "die", "das", "den"],
      "answer": 1
    },
    {
      "type": "fill",
      "prompt": "Wir haben ___ (m) Hund.",
      "answers": ["den"]
    },
    {
      "type": "fill",
      "prompt": "Er liest ___ (n) Buch.",
