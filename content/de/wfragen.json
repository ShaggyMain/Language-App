      "rows": [
        ["wer", "kto", "Wer ist das?"],
        ["was", "co", "Was machst du?"],
        ["wo", "gdzie", "Wo wohnst du?"],
        ["wann", "kiedy", "Wann kommst du?"],
        ["wie", "jak", "Wie heißt du?"],
